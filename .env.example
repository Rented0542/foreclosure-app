# LLM (OpenAI-compatible). Default: self-hosted Manifest gateway.
LLM_BASE_URL=http://localhost:2099/v1
LLM_API_KEY=mnfst_local
# Optional direct free providers (used as fallback if gateway down)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Database: leave empty for local SQLite file (data/app.db). Set for Postgres portal.
DATABASE_URL=
# Auth
AUTH_SECRET=change-me-in-production
# Team mode
TEAM_MODE=false
# Background scheduler (proactive scans)
ENABLE_SCHEDULER=true
# Outreach (free channels)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Twilio (optional, paid)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=