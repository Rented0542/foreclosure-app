{
  "name": "foreclosure-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Find foreclosed properties and match them to worthy buyers. Local-first, $0 LLM via free providers + Manifest gateway.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "data:export": "tsx scripts/export-data.ts",
    "data:import": "tsx scripts/import-data.ts",
    "scan:properties": "tsx scripts/scan-properties.ts",
    "scrape:buyers": "tsx scripts/scrape-buyers.ts",
    "match": "tsx scripts/run-matching.ts",
    "license:check": "license-checker --production --summary --failOn \"GPL;AGPL;LGPL;SSPL;CC-BY-NC;Non-Commercial\""
  },
  "dependencies": {
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "drizzle-orm": "^0.45.2",
    "better-sqlite3": "^11.5.0",
    "pg": "^8.13.1",
    "better-auth": "^1.1.0",
    "openai": "^4.73.0",
    "zod": "^3.23.8",
    "cheerio": "^1.0.0",
    "playwright": "^1.49.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "yaml": "^2.6.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "lucide-react": "^0.460.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/pg": "^8.11.10",
    "@types/nodemailer": "^6.4.17",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.6.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.3",
    "drizzle-kit": "^0.31.11",
    "license-checker": "^25.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49"
  }
}